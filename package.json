  "private": true,
  "main": "electron/main.ts",
  "scripts": {
    "dev": "next dev",
    "dev:web": "next dev",
    "dev:electron": "wait-on http://localhost:3000 && NODE_OPTIONS=\"--import tsx\" electron ./electron/main.ts",
